# Python bytecode and package builds
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local environments and package caches
.venv/
venv/
.uv-cache/
.cache/
.legacy_runtime_cache/

# Test, type-checker, and coverage outputs
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Notebook and editor state
.ipynb_checkpoints/
.idea/
.vscode/
*~

# Local configuration
.env
.env.*
!.env.example

# Generated experiment outputs can exceed normal Git hosting limits.
# Curated, publication-ready results belong in evidence/.
artifacts/*
!artifacts/README.md

# Earlier exploratory notebooks are retained locally, not published.
notebooks/archive/
